<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      La foto de la factura se adjunta con el selector del sistema (Photo Picker /
      ActivityResultContracts.GetContent), que no requiere permisos de CAMARA ni
      de almacenamiento. Si más adelante se agrega captura directa con la cámara,
      hay que declarar CAMERA + un FileProvider para el archivo temporal.
    -->

    <application
        android:name=".ConsorcioApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.ConsorcioTransparente"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".ui.facturas.AddExpenseActivity"
            android:exported="false" />

        <activity
            android:name=".ui.votaciones.VoteDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.votaciones.CreateVoteActivity"
            android:exported="false" />

        <activity
            android:name=".ui.muro.CreatePostActivity"
            android:exported="false" />

        <activity
            android:name=".ui.muro.ModerationActivity"
            android:exported="false" />

        <activity
            android:name=".ui.reservas.ReservasActivity"
            android:exported="false" />

        <activity
            android:name=".ui.building.BuildingConfigActivity"
            android:exported="false" />

        <activity
            android:name=".ui.tickets.TicketsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.tickets.CreateTicketActivity"
            android:exported="false" />

        <activity
            android:name=".ui.tickets.TicketDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.vecinos.VecinosActivity"
            android:exported="false" />

        <activity
            android:name=".ui.pagos.PagarActivity"
            android:exported="false" />

        <activity
            android:name=".ui.pagos.CobrosActivity"
            android:exported="false" />

    </application>

</manifest>
