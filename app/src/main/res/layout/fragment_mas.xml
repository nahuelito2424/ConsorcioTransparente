<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Más"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/itemBuildingConfig"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_card"
        android:clickable="true"
        android:focusable="true"
        android:padding="14dp"
        android:text="@string/building_config_menu_item"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/itemTickets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_card"
        android:clickable="true"
        android:focusable="true"
        android:padding="14dp"
        android:text="@string/tickets_menu_item"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/itemReservas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_card"
        android:clickable="true"
        android:focusable="true"
        android:padding="14dp"
        android:text="🏊 Reserva de espacios comunes (SUM, parrilla, pileta)"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/itemVecinos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_card"
        android:clickable="true"
        android:focusable="true"
        android:padding="14dp"
        android:text="@string/vecinos_menu_item"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/itemPagar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_card"
        android:clickable="true"
        android:focusable="true"
        android:padding="14dp"
        android:text="@string/pagar_menu_item"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/itemCobros"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_card"
        android:clickable="true"
        android:focusable="true"
        android:padding="14dp"
        android:text="@string/cobros_menu_item"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/itemProveedores"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_card"
        android:clickable="true"
        android:focusable="true"
        android:padding="14dp"
        android:text="@string/providers_menu_item"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/itemProtocolos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_card"
        android:clickable="true"
        android:focusable="true"
        android:padding="14dp"
        android:text="@string/protocols_menu_item"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/simple_mode_item"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchSimpleMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:showText="false" />
    </LinearLayout>

    <Button
        android:id="@+id/buttonLogout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/logout"
        android:textAllCaps="false"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

</LinearLayout>
