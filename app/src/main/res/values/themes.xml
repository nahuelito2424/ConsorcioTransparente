<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Light (no DayNight): la paleta de @color/colors.xml es sólo de modo claro, tomada
      del wireframe. Con DayNight, un celular en modo oscuro del sistema hacía que el
      texto por defecto saliera claro sobre nuestros fondos blancos (invisible) — fijar
      el tema a Light evita ese problema en toda la app, no sólo en el login.
    -->
    <style name="Theme.ConsorcioTransparente" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/navy</item>
        <item name="colorPrimaryDark">@color/navy_dark</item>
        <item name="colorAccent">@color/blue_accent</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/navy</item>
        <item name="colorTextSecondary">@color/text_secondary</item>
    </style>

    <!--
      "Modo simple" (accesibilidad, ver BaseActivity y SimpleModePrefs): mismo tema de
      siempre, pero el texto secundario pasa a negro pleno (igual que el primario) para
      que no haya letra gris difícil de leer. El tamaño de letra más grande no es un
      tema — lo aplica BaseActivity vía Configuration.fontScale.
    -->
    <style name="Theme.ConsorcioTransparente.Simple">
        <item name="colorTextSecondary">@color/text_primary</item>
    </style>

    <style name="MetricCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_metric_card</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="MetricValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/navy</item>
    </style>

    <style name="MetricLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">?attr/colorTextSecondary</item>
    </style>

    <!--
      Fila de menú con ícono + texto + chevron (ej. "Más"): mismo patrón repetido en
      varios items, así que el boilerplate de layout va en estilos — el contenido
      (ícono, texto, visibility) lo sigue fijando cada fila.
    -->
    <style name="MasMenuRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:paddingVertical">12dp</item>
    </style>

    <style name="MasMenuIconBadge">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/bg_icon_badge</item>
        <item name="android:backgroundTint">@color/tag_blue_bg</item>
    </style>

    <style name="MasMenuIcon">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:tint">@color/navy</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="MasMenuLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="MasMenuChevron">
        <item name="android:layout_width">18dp</item>
        <item name="android:layout_height">18dp</item>
        <item name="android:src">@drawable/ic_chevron_right</item>
        <item name="android:tint">?attr/colorTextSecondary</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
</resources>
